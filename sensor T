#include <xc.h>
#include <stdint.h>
#include <stdio.h>
#include "Configuracion.h"
#include "LCD.h"

#define DHT11_PIN PORTBbits.RB0
#define DHT11_TRIS TRISBbits.TRISB0

uint8_t hum_int, hum_dec, temp_int, temp_dec, chk_sum;

void DHT11_Iniciar(void) {
    DHT11_TRIS = 0;         // Salida
    LATBbits.LATB0 = 0;     // Nivel bajo
    __delay_ms(18);         // Espera de inicio
    LATBbits.LATB0 = 1;     // Nivel alto
    __delay_us(20);         
    DHT11_TRIS = 1;         // Entrada
}

uint8_t DHT11_Respuesta(void) {
    while (DHT11_PIN);           // Espera a que baje
    while (!DHT11_PIN);          // Espera a que suba
    while (DHT11_PIN);           // Espera a que vuelva a bajar
    return 1;
}

uint8_t DHT11_LeerByte(void) {
    uint8_t i, data = 0;
    for (i = 0; i < 8; i++) {
        while (!DHT11_PIN);      // Espera al pulso bajo
        __delay_us(30);
        if (DHT11_PIN)
            data = (data << 1) | 1;
        else
            data <<= 1;
        while (DHT11_PIN);       // Espera a que baje de nuevo
    }
    return data;
}

void Mostrar_Error(const char* linea1, const char* linea2) {
    LCD_Clear();
    LCD_String_xy(0, 0, linea1);
    LCD_String_xy(1, 0, linea2);
    __delay_ms(1000);
}

void Mostrar_Datos(void) {
    char buffer[10];
    
    LCD_Clear();
    
    LCD_String_xy(0, 0, "RH: ");
    sprintf(buffer, "%d.%d %%", hum_int, hum_dec);
    LCD_String(buffer);

    LCD_String_xy(1, 0, "TEMP: ");
    sprintf(buffer, "%d.%d ", temp_int, temp_dec);
    LCD_String(buffer);
    LCD_Char(0xDF); // ° símbolo
    LCD_Char('C');
}

void main(void) {
    OSCCONbits.IRCF = 0b111;
    OSCCONbits.SCS = 0b10;
    ADCON1 = 0x0F;

    TRISBbits.TRISB0 = 1; // Inicialmente entrada

    LCD_Init();
    LCD_String_xy(0, 0, "SENSOR DHT11");
    LCD_String_xy(1, 0, "INICIANDO...");
    __delay_ms(1000);
    LCD_Clear();

    while (1) {
        DHT11_Iniciar();

        if (DHT11_Respuesta()) {
            hum_int  = DHT11_LeerByte();
            hum_dec  = DHT11_LeerByte();
            temp_int = DHT11_LeerByte();
            temp_dec = DHT11_LeerByte();
            chk_sum  = DHT11_LeerByte();

            if ((hum_int + hum_dec + temp_int + temp_dec) == chk_sum)
                Mostrar_Datos();
            else
                Mostrar_Error("CHECKSUM!!", "ERROR!!");
        } else {
            Mostrar_Error("UNRESPONSIVE", "ERROR!!");
        }

        __delay_ms(2000); // Tiempo recomendado entre lecturas
    }
}
